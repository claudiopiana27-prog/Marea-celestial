# ---------- Tipos MIME ----------
AddType application/manifest+json .webmanifest
AddType application/json .json
<FilesMatch "\.(webmanifest)$">
    Header set Content-Type application/manifest+json
</FilesMatch>

# ---------- No listar directorios ----------
Options -Indexes

# ---------- Bloquear archivos sensibles por extensión ----------
<FilesMatch "\.(sql|sqlite|db|phar|env|log|bak|ini|sh|yml|yaml|md)$">
    Require all denied
</FilesMatch>

# ---------- Bloquear archivos de configuración y dependencias ----------
<FilesMatch "^(composer\.(json|lock)|config\.php)$">
    Require all denied
</FilesMatch>

# ---------- Bloquear carpetas de control de versiones y metadatos ----------
RewriteEngine On
RewriteRule (^|/)\.(git|env|freebuff)(/|$) - [F,L]

# ---------- Headers de seguridad ----------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ---------- URLs amigables ----------
RewriteRule ^robots\.txt$ robots.php [L]
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# ---------- Página 404 ----------
# Ajustar esta ruta si el sitio se publica en la raíz del dominio.
ErrorDocument 404 /Marea_celestial/404.php

# ---------- Compresión ----------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/manifest+json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------- Cache de assets ----------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/jpeg "access plus 6 months"
    ExpiresByType image/png "access plus 6 months"
    ExpiresByType image/webp "access plus 6 months"
    ExpiresByType image/svg+xml "access plus 6 months"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
